  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cytosorbents", "server", "opentelemetry", "uptime"],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "serenedb" },
        "definition": "SELECT DISTINCT resource_attributes->>'host.name' AS __text, resource_attributes->>'host.name' AS __value FROM (\n  SELECT resource_attributes FROM otel_metrics_gauge\n  UNION ALL SELECT resource_attributes FROM otel_metrics_sum\n  UNION ALL SELECT resource_attributes FROM otel_logs\n) s\nWHERE resource_attributes->>'host.name' IS NOT NULL\nORDER BY 1",
        "query": "SELECT DISTINCT resource_attributes->>'host.name' AS __text, resource_attributes->>'host.name' AS __value FROM (\n  SELECT resource_attributes FROM otel_metrics_gauge\n  UNION ALL SELECT resource_attributes FROM otel_metrics_sum\n  UNION ALL SELECT resource_attributes FROM otel_logs\n) s\nWHERE resource_attributes->>'host.name' IS NOT NULL\nORDER BY 1",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
