          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT value AS \"Host uptime\"\nFROM otel_metrics_gauge\nWHERE metric_name = 'system.uptime'\n  AND resource_attributes->>'host.name' = '$host'\n  AND $__timeFilter(\"timestamp\")\nORDER BY \"timestamp\" DESC\nLIMIT 1"
        }
      ]
    },
