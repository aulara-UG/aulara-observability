          "rawSql": "SELECT \"timestamp\" AS time, 'process.uptime' AS metric, value\nFROM otel_metrics_gauge\nWHERE metric_name = 'process.uptime'\n  AND resource_attributes->>'host.name' = '$host'\n  AND $__timeFilter(\"timestamp\")\nORDER BY 1"
