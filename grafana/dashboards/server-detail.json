          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  \"timestamp\",\n  coalesce(resource_attributes->>'service.name', service_name) AS service,\n  body\nFROM otel_logs\nWHERE resource_attributes->>'host.name' = '$host'\n  AND $__timeFilter(\"timestamp\")\nORDER BY \"timestamp\" DESC\nLIMIT 200"
