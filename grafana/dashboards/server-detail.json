  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Status",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "serenedb" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "UP": { "color": "green", "index": 0, "text": "UP" }, "DOWN": { "color": "red", "index": 1, "text": "DOWN" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "serenedb" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN max(\"timestamp\") > now() - interval '5 minutes' THEN 'UP' ELSE 'DOWN' END AS \"Status\"\nFROM otel_metrics_gauge\nWHERE resource_attributes->>'host.name' = '$host'"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Service uptime",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "serenedb" },
      "fieldConfig": { "defaults": { "unit": "dtdurations" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "serenedb" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT value AS \"Uptime\"\nFROM otel_metrics_gauge\nWHERE metric_name = 'process.uptime'\n  AND resource_attributes->>'host.name' = '$host'\n  AND $__timeFilter(\"timestamp\")\nORDER BY \"timestamp\" DESC\nLIMIT 1"
        }
      ]
    },
    {
      "type": "stat",
