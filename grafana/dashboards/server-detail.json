          "datasource": { "type": "grafana-postgresql-datasource", "uid": "serenedb" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(\"timestamp\", $__interval),\n  count(*) AS value\nFROM otel_logs\nWHERE resource_attributes->>'host.name' = '$host'\n  AND $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1"
