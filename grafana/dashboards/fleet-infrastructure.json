    {
      "type": "table",
      "id": 10,
      "title": "Host infrastructure matrix",
      "description": "UP/DOWN via nanosecond freshness. CPU/mem percentiles on corrected series.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "serenedb"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "UP": {
                        "color": "green",
                        "index": 0,
                        "text": "UP"
                      },
                      "DOWN": {
                        "color": "red",
                        "index": 1,
                        "text": "DOWN"
                      },
                      "OK": {
                        "color": "green",
                        "index": 0,
                        "text": "OK"
                      },
                      "FAIL": {
                        "color": "red",
                        "index": 1,
                        "text": "FAIL"
                      },
                      "STALE": {
                        "color": "orange",
                        "index": 2,
                        "text": "STALE"
                      },
                      "QUIET": {
                        "color": "yellow",
                        "index": 3,
                        "text": "QUIET"
                      },
                      "UNKNOWN": {
                        "color": "super-light-yellow",
                        "index": 4,
                        "text": "UNKNOWN"
                      },
                      "RECENT_BOOT": {
                        "color": "purple",
                        "index": 5,
                        "text": "RECENT BOOT"
                      },
                      "STABLE": {
                        "color": "green",
                        "index": 6,
                        "text": "STABLE"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "boot"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RECENT_BOOT": {
                        "color": "purple",
                        "index": 0,
                        "text": "RECENT BOOT"
                      },
                      "STABLE": {
                        "color": "green",
                        "index": 1,
                        "text": "STABLE"
                      }
                    }
                  }
                ]
              }
