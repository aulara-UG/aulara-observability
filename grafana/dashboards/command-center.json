      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "serenedb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH samples AS (\n  SELECT resource_attributes->>'host.name' AS host,\n         attributes->>'cpu' AS cpu,\n         date_trunc('minute', (\"timestamp\")::timestamp) AS bucket,\n         1 - avg(value) AS busy\n  FROM otel_metrics_gauge\n  WHERE metric_name = 'system.cpu.utilization'\n    AND attributes->>'state' = 'idle'\n    AND $__timeFilter(\"timestamp\")\n    AND TRUE\n    AND \"timestamp\" > make_timestamp_ns((extract(epoch from now()) - 300)::bigint * 1000000000)\n  GROUP BY 1, 2, 3\n)\nSELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY busy) FROM samples"
        }
      ]
