    {
      "type": "table",
      "id": 20,
      "title": "Host status board",
      "description": "Live board. Open Host Detail with the host variable set.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "serenedb"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "UP": {
                        "color": "green",
                        "index": 0,
                        "text": "UP"
                      },
                      "DOWN": {
                        "color": "red",
                        "index": 1,
                        "text": "DOWN"
                      },
                      "OK": {
                        "color": "green",
                        "index": 0,
                        "text": "OK"
                      },
                      "FAIL": {
                        "color": "red",
                        "index": 1,
                        "text": "FAIL"
                      },
                      "STALE": {
                        "color": "orange",
                        "index": 2,
                        "text": "STALE"
                      },
                      "UNKNOWN": {
                        "color": "super-light-yellow",
                        "index": 3,
                        "text": "UNKNOWN"
                      },
                      "RECENT_BOOT": {
                        "color": "purple",
                        "index": 4,
                        "text": "RECENT BOOT"
                      },
                      "STABLE": {
                        "color": "green",
                        "index": 5,
                        "text": "STABLE"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uptime_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu_busy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mem_used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "serenedb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH hosts AS (\n  SELECT DISTINCT resource_attributes->>'host.name' AS host\n  FROM otel_metrics_gauge\n  WHERE resource_attributes->>'host.name' IS NOT NULL AND $__timeFilter(\"timestamp\")\n),\nalive AS (\n  SELECT resource_attributes->>'host.name' AS host, max(\"timestamp\") AS last_seen\n  FROM otel_metrics_gauge\n  WHERE metric_name = 'system.uptime' AND \"timestamp\" > make_timestamp_ns((extract(epoch from now()) - 300)::bigint * 1000000000)\n  GROUP BY 1\n),\ncpu AS (\n  SELECT resource_attributes->>'host.name' AS host, 1 - avg(value) AS cpu_busy\n  FROM otel_metrics_gauge\n  WHERE metric_name = 'system.cpu.utilization' AND attributes->>'state' = 'idle' AND \"timestamp\" > make_timestamp_ns((extract(epoch from now()) - 300)::bigint * 1000000000)\n  GROUP BY 1\n),\nmem AS (\n  SELECT DISTINCT ON (resource_attributes->>'host.name')\n         resource_attributes->>'host.name' AS host, value AS mem_used\n  FROM otel_metrics_gauge\n  WHERE metric_name = 'system.memory.utilization' AND attributes->>'state' = 'used' AND \"timestamp\" > make_timestamp_ns((extract(epoch from now()) - 300)::bigint * 1000000000)\n  ORDER BY resource_attributes->>'host.name', \"timestamp\" DESC\n),\nuptime AS (\n  SELECT DISTINCT ON (resource_attributes->>'host.name')\n         resource_attributes->>'host.name' AS host, value AS uptime_s\n  FROM otel_metrics_gauge\n  WHERE metric_name = 'system.uptime' AND \"timestamp\" > make_timestamp_ns((extract(epoch from now()) - 300)::bigint * 1000000000)\n  ORDER BY resource_attributes->>'host.name', \"timestamp\" DESC\n),\nerrs AS (\n  SELECT resource_attributes->>'host.name' AS host, count(*) AS errors\n  FROM otel_logs WHERE $__timeFilter(\"timestamp\") AND (\n    log_attributes->>'log.kind' = 'error'\n    OR log_attributes->>'exception.type' IS NOT NULL\n    OR upper(coalesce(severity_text, '')) IN ('ERROR', 'FATAL', 'CRITICAL')\n    OR severity_number >= 17\n  )\n  AND NOT (\n    log_attributes->>'backup.status' = 'success'\n    OR log_attributes->>'event.name' = 'backup.success'\n    OR log_attributes->>'event.name' = 'otel-backup-event'\n  )\n  GROUP BY 1\n)\nSELECT h.host,\n       CASE WHEN a.host IS NOT NULL THEN 'UP' ELSE 'DOWN' END AS status,\n       u.uptime_s,\n       c.cpu_busy,\n       m.mem_used,\n       coalesce(e.errors, 0) AS errors\nFROM hosts h\nLEFT JOIN alive a ON a.host = h.host\nLEFT JOIN cpu c ON c.host = h.host\nLEFT JOIN mem m ON m.host = h.host\nLEFT JOIN uptime u ON u.host = h.host\nLEFT JOIN errs e ON e.host = h.host\nORDER BY status ASC, errors DESC, h.host"
        }
      ]
    },
