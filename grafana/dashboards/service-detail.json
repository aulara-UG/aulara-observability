      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "UP": {
                        "color": "green",
                        "index": 0,
                        "text": "UP"
                      },
                      "DOWN": {
                        "color": "red",
                        "index": 1,
                        "text": "DOWN"
                      },
                      "OK": {
                        "color": "green",
                        "index": 0,
                        "text": "OK"
                      },
                      "FAIL": {
                        "color": "red",
                        "index": 1,
                        "text": "FAIL"
                      },
                      "STALE": {
                        "color": "orange",
                        "index": 2,
                        "text": "STALE"
                      },
                      "UNKNOWN": {
                        "color": "super-light-yellow",
                        "index": 3,
                        "text": "UNKNOWN"
                      },
                      "RECENT_BOOT": {
                        "color": "purple",
                        "index": 4,
                        "text": "RECENT BOOT"
                      },
                      "STABLE": {
                        "color": "green",
                        "index": 5,
                        "text": "STABLE"
                      }
                    }
                  }
                ]
              }
            ]
          }
