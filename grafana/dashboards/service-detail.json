      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "serenedb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT resource_attributes->>'host.name' AS host,\n       count(*) AS log_lines,\n       count(*) FILTER (WHERE (\n    log_attributes->>'log.kind' = 'error'\n    OR log_attributes->>'exception.type' IS NOT NULL\n    OR upper(coalesce(severity_text, '')) IN ('ERROR', 'FATAL', 'CRITICAL')\n    OR severity_number >= 17\n  )\n  AND NOT (\n    log_attributes->>'backup.status' = 'success'\n    OR log_attributes->>'event.name' = 'backup.success'\n    OR log_attributes->>'event.name' = 'otel-backup-event'\n  )) AS errors,\n       max(\"timestamp\") AS last_seen,\n       CASE WHEN epoch_ns(max(\"timestamp\")) > (extract(epoch from now()) - 300) * 1000000000 THEN 'UP' ELSE 'STALE' END AS status\nFROM otel_logs\nWHERE coalesce(resource_attributes->>'service.name', service_name) = '$service' AND $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY errors DESC, last_seen DESC"
        }
      ]
    },
