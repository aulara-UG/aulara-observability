# SereneDB bootstrap (set once at first volume init)
POSTGRES_PASSWORD=change-me-superuser

# Dedicated OTLP ingest role (Basic Auth to SereneDB :4318)
OTEL_INGEST_USER=otel_ingest
OTEL_INGEST_PASSWORD=change-me-otel-ingest

# Dedicated Grafana read-only role
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change-me-grafana-ro

# Grafana admin UI
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin

# Collector → SereneDB
SERENEDB_OTLP_ENDPOINT=http://serenedb.railway.internal:4318

# Multi-tenant inbound OTLP credentials (username = tenant.id)
# Format: tenantA:passwordA,tenantB:passwordB
OTEL_TENANTS=demo-acme:change-me,demo-globex:change-me,internal-smoke:change-me
OTEL_HTPASSWD_FILE=/tmp/otel.htpasswd

# Grafana → SereneDB
SERENEDB_HOST=serenedb.railway.internal
SERENEDB_PORT=7890
