# Almost everything is auto-wired on Railway via ${{secret()}} and
# ${{serenedb.*}} references. Static usernames/ports are baked into images.

# --- SereneDB (auto-generated on template deploy) ---
# POSTGRES_PASSWORD=${{secret()}}
# OTEL_INGEST_PASSWORD=${{secret()}}
# GRAFANA_DB_PASSWORD=${{secret()}}
# (users otel_ingest / grafana_ro are image defaults)

# --- Grafana (auto) ---
# GF_SECURITY_ADMIN_PASSWORD=${{secret()}}
# GF_SERVER_ROOT_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# SERENEDB_HOST=${{serenedb.RAILWAY_PRIVATE_DOMAIN}}
# GRAFANA_DB_PASSWORD=${{serenedb.GRAFANA_DB_PASSWORD}}
# (admin user, PORT, SERENEDB_PORT, GRAFANA_DB_USER are image defaults)

# --- Collector (auto + one demo tenant) ---
# OTEL_INGEST_PASSWORD=${{serenedb.OTEL_INGEST_PASSWORD}}
# SERENEDB_OTLP_ENDPOINT=http://${{serenedb.RAILWAY_PRIVATE_DOMAIN}}:4318
# OTEL_TENANTS=demo:${{secret(24)}}

# Optional: add more tenants (comma-separated user:password)
# OTEL_TENANTS=demo:xxxx,acme:yyyy
